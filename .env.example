# Arabic1010 Environment Variables
# Copy this file to .env and fill in your values

# App Configuration
VITE_APP_TITLE=Arabic1010
VITE_APP_URL=http://localhost:5173

# Audio CDN
# Point this at your CDN or server root where /audio/ lives.
# Leave empty to use the browser Web Speech API fallback (demo mode).
# Example: https://cdn.arabic1010.app
VITE_AUDIO_CDN=

# Feature Flags
# PRODUCTION: set to "false" to enable freemium gating.
# DEVELOPMENT: set to "true" to unlock all content for testing.
# Default is "false" (gating ON) — override locally in .env.
VITE_DEV_UNLOCK_ALL=false

# Supabase authentication is enabled whenever the project URL and anon key
# are present. Billing/checkout is configured separately below.
VITE_APP_ENV=demo
VITE_ENABLE_PRODUCTION_SERVICES=false
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional aliases supported by the app:
# VITE_SUPABASE_KEY=
# VITE_NEXT_PUBLIC_SUPABASE_URL=
# VITE_NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated emails that receive reviewer/premium access across the
# whole platform. Matching is case-insensitive. No Supabase role metadata is
# required for these accounts.
# Example: VITE_REVIEWER_EMAILS=reviewer@example.com,qa@example.com
VITE_REVIEWER_EMAILS=

# Optional: only needed for Stripe checkout. Missing values do not block login.
# Example: https://<project-ref>.supabase.co/functions/v1/create-checkout-session
VITE_CHECKOUT_FUNCTION_URL=
