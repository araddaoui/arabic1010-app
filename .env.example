# Arabic1010 Environment Variables
# Copy this file to .env and fill in your values

# App Configuration
VITE_APP_TITLE=Arabic1010
VITE_APP_URL=http://localhost:5173

# Audio CDN
# Point this at your CDN or server root where /audio/ lives.
# Leave empty to use the browser Web Speech API fallback (demo mode).
# Example: https://cdn.arabic1010.app
VITE_AUDIO_CDN=

# Feature Flags
# PRODUCTION: set to "false" to enable freemium gating.
# DEVELOPMENT: set to "true" to unlock all content for testing.
# Default is "false" (gating ON) — override locally in .env.
VITE_DEV_UNLOCK_ALL=false

# Production services remain disabled unless explicitly set to "true".
VITE_APP_ENV=demo
VITE_ENABLE_PRODUCTION_SERVICES=false
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Example: https://<project-ref>.supabase.co/functions/v1/create-checkout-session
VITE_CHECKOUT_FUNCTION_URL=
